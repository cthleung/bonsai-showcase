# Copy to .env (gitignored) and fill in for this computer.
BONSAI_VAULT=~/vault
BONSAI_STATE=~/bonsai-state
# win or mac: which inbox folder (0 Inbox/<machine>) this computer writes. Defaults by platform.
BONSAI_MACHINE=win
# Optional: local agent sessions (capture claude-code, capture codex, both in the hourly run).
# SpecStory history folders, split on ";", each with an optional =<visibility> (private, creative,
# career, public). Unset means no SpecStory capture.
# BONSAI_SPECSTORY_DIRS=~/novel/.specstory/history=creative;~/work/.specstory/history
# Optional: the visibility of a repo's agent sessions when its folder above has none, by repo folder
# name, split on ";". Unset means every repo is private.
# BONSAI_REPO_VISIBILITY=novel=creative;work=career
# Which SpecStory agents to capture (claude-code, copilot, copilot-cli, codex-cli); unset is all of them.
# BONSAI_SPECSTORY_AGENTS=
# Codex's session transcripts, if not $CODEX_HOME/sessions or ~/.codex/sessions. Only the
# rollout-*.jsonl files there are read; nothing else in .codex is opened.
# BONSAI_CODEX_SESSIONS=
